DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_DB=

HTTP_PORT=

# Structured logging. LOG_LEVEL is one of debug/info/warn/error (anything
# unrecognized falls back to info); defaults to info. LOG_FORMAT is "json" for
# the real deploy (what a downstream log collector parses) or "text" for
# readable local development; defaults to json.
LOG_LEVEL=
LOG_FORMAT=

# Shared secret for every /api/private/* route (n8n → Agregado), sent as
# X-Enrichment-Secret.
ENRICHMENT_SECRET=

# Origin used to build absolute links in the Digest ({base}/r/{article-id} and
# the vote links). Defaults to http://localhost:8080.
#
# In production this is Agregado's tailnet hostname behind the homelab-edge
# Caddy (docs/adr/0008). Agregado has no public route; the Cloudflare Tunnel
# carries only the Bridge's Resend webhook to n8n.
# A trailing slash is trimmed.
#
# Leave blank for local dev. Blank falls back to the default above.
PUBLIC_BASE_URL=

# Cloudflare Workers AI model. Use an instruct model, not a code model — the
# provider does summarization/categorization/scoring, not code generation.
# Defaults to @cf/google/gemma-4-26b-a4b-it.
AI_MODEL=

# Bounds a single Cloudflare AI call. Digest compute makes several calls back
# to back (categorize/summarize/digest) under one overall budget, so this caps
# how much of that budget one slow call can consume. Defaults to 90s (the
# configured reasoning model emits a verbose reasoning trace before its
# answer, so a real digest-selection call can take well over 30s).
AI_REQUEST_TIMEOUT=

# How much article body Score/Categorize/Reason feed the model, in characters.
# Defaults to 8000.
AI_MAX_CONTENT_CHARS=

# Langfuse (optional). Each Article's enrichment becomes a trace with one
# generation per model call, exported over OTLP/HTTP to
# {LANGFUSE_BASE_URL}/api/public/otel. Tracing is on only when all three are
# set; leave any blank and Agregado runs exactly as without Langfuse. In prod
# the base URL is http://langfuse-web:3000 over the private langfuse-ingest
# Docker network; keys are the agregado project's pair from Langfuse settings.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# With Langfuse configured, the four live prompts (article_summary,
# categorize, digest_select, preference_score) are served from Langfuse
# (agregado/<operation> at label production), cached in memory for this long;
# promoting a version takes effect within it. Seed version 1 of each once
# with `make seed-langfuse-prompts`. Default 60s.
LANGFUSE_PROMPT_CACHE_TTL=

# Article content fetching (Phase 17 — fetches the real page behind an
# Article's canonical URL, instead of trusting the feed's teaser).
# Bounds a single article-page fetch. Defaults to 15s.
FETCH_TIMEOUT=
# Caps how much of a response body is read, in bytes. Defaults to 5242880 (5MB).
FETCH_MAX_BYTES=
# Quality-gate floor: extracted plain text shorter than this (in characters)
# is treated as a failed fetch (consent wall/SPA shell/paywall) and the
# article falls back to feed content. Defaults to 500.
FETCH_MIN_CONTENT_CHARS=
# Identifies the fetcher truthfully — no browser-UA spoofing.
FETCH_USER_AGENT=
# Caps the algorithmic distillation pass that produces distilled_content, in
# characters. Defaults to 2000.
DISTILL_MAX_CHARS=

# Karakeep, the Bookmarker. Read only by cmd/migrate-ownership (issue #83) —
# the long-running server never calls Karakeep, so leaving these blank is fine
# for a normal deploy. KARAKEEP_ADDRESS is the origin, without /api/v1.
KARAKEEP_ADDRESS=
KARAKEEP_API_KEY=
KARAKEEP_TIMEOUT=30s

# Newsletters app (cmd/bridge-admin, spec #225, ADR-0012). Read only by that
# binary; Agregado itself ignores them. Its credentials are dedicated ones,
# revocable without touching n8n's or Agregado's.
#
# CLOUDFLARE_ACCOUNT_ID above is shared (same account). The token is NOT the
# Workers AI one: it needs D1 Edit on the `bridge` database. R2 access is a
# separate credential, below.
BRIDGE_ADMIN_CF_API_TOKEN=
# The `bridge` D1 database id (email-worker/wrangler.jsonc). Same name n8n uses.
BRIDGE_D1_DATABASE_ID=
# The Bridge Worker's origin, scheme and host, no trailing slash. Same as
# n8n's BRIDGE_ORIGIN. Feeds are {BRIDGE_ORIGIN}/feed/<alias>.atom: Add
# subscribes Miniflux to that URL and the List matches feeds by it.
BRIDGE_ORIGIN=
# The Resend catch-all domain. Each Source's receiving address is
# <alias>@BRIDGE_RECEIVING_DOMAIN.
BRIDGE_RECEIVING_DOMAIN=
# Miniflux origin and an API key (Miniflux Settings > API Keys) for the app.
# In prod: http://miniflux:8080 over the edge network.
MINIFLUX_URL=
BRIDGE_ADMIN_MINIFLUX_API_KEY=
# Delete (#230) removes a Source's stored issues from R2 through the S3 API.
# Create an R2 API token with "Object Read & Write" scoped to this bucket only
# (R2 > Manage API tokens) and paste its Access Key ID and Secret Access Key.
# Dedicated to the app, not n8n's BRIDGE_R2_ACCESS_KEY_ID/SECRET. The bucket
# name is the one n8n uses.
BRIDGE_R2_BUCKET=bridge-original-html
BRIDGE_ADMIN_R2_ACCESS_KEY_ID=
BRIDGE_ADMIN_R2_SECRET_ACCESS_KEY=

# A Resend API key of the app's own, for reading received mail (Confirm and
# Unclaimed mail). Resend has no read-only key type and sending-only keys
# cannot read received mail, so this must be a full-access key. Keep it
# separate from n8n's so either can be revoked alone. The app only reads.
BRIDGE_ADMIN_RESEND_API_KEY=
